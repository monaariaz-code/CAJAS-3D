    function handleModelFileUpload(files) {
      if (!files || !files.length) return;
      Array.from(files).forEach((file, idx) => {
        const ext = file.name.split('.').pop().toLowerCase();
        const offset = (idx * 0.3) - 0.3;
        const reader = new FileReader();

        const addModel = (obj) => {
          createCustomItemFromData({
            name: file.name.substring(0, 14),
            shapeType: 'model',
            model: obj,
            baseColor: '#9ca3af',
            x: Math.max(-0.9, Math.min(0.9, offset)),
            z: Math.max(-0.9, Math.min(0.9, offset * 0.8)),
            rotY: 0,
            scale: 1.0,
            depth: 0.1,
            artName: ext.toUpperCase()
          });
          renderItemsStudioUI();
          switchSidebarTab('items');
          if (currentOpenProgress < 0.3) setLidOpenProgress(100);
        };

        const fail = () => {
          showAppModal(
            'Formato no compatible',
            `No se pudo leer el archivo "${file.name}". Te recomendamos usar .glb (con texturas incrustadas), .gltf autónomo o .obj estándar.`
          );
        };

        if (ext === 'glb') {
          reader.onload = (e) => {
            try { new THREE.GLTFLoader().parse(e.target.result, '', (gltf) => addModel(gltf.scene), fail); }
            catch (err) { fail(); }
          };
          reader.readAsArrayBuffer(file);
        } else if (ext === 'gltf') {
          reader.onload = (e) => {
            try { new THREE.GLTFLoader().parse(e.target.result, '', (gltf) => addModel(gltf.scene), fail); }
            catch (err) { fail(); }
          };
          reader.readAsText(file);
        } else if (ext === 'obj') {
          reader.onload = (e) => {
            try {
              const obj = new THREE.OBJLoader().parse(e.target.result);
              obj.traverse(c => {
                if (c.isMesh) {
                  if (!c.geometry.attributes.normal) c.geometry.computeVertexNormals();
                  c.material = new THREE.MeshStandardMaterial({ color: 0x9ca3af, roughness: 0.5, metalness: 0.1, side: THREE.DoubleSide });
                }
              });
              addModel(obj);
            } catch (err) { fail(); }
          };
          reader.readAsText(file);
        } else {
          fail();
        }
      });
    }

