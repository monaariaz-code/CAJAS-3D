    function buildContratapaCard() {
      const cardCanvas = document.createElement('canvas');
      cardCanvas.width = 1024;
      cardCanvas.height = 1024;
      const ctx = cardCanvas.getContext('2d');

      ctx.fillStyle = '#111317';
      ctx.fillRect(0, 0, 1024, 1024);

      ctx.strokeStyle = '#10b981';
      ctx.lineWidth = 12;
      ctx.strokeRect(40, 40, 944, 944);

      ctx.fillStyle = '#ffffff';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.font = '900 68px "Inter", sans-serif';
      ctx.fillText('CERTIFICADO DE EMPAQUE', 512, 380);

      ctx.font = '500 38px "Inter", sans-serif';
      ctx.fillStyle = '#94a3b8';
      ctx.fillText('ESTRUCTURA RÍGIDA • CIERRE MAGNÉTICO', 512, 480);

      ctx.font = '700 44px "Inter", sans-serif';
      ctx.fillStyle = '#34d399';
      ctx.fillText('MOCKUP 3D PROFESIONAL', 512, 580);

      planchetteTexture = new THREE.CanvasTexture(cardCanvas);
      planchetteTexture.anisotropy = 8;

      const cardGeo = new THREE.PlaneGeometry(1.8, 1.8);
      const cardMat = new THREE.MeshStandardMaterial({
        map: planchetteTexture,
        roughness: 0.45,
        metalness: 0.05,
        side: THREE.DoubleSide
      });

      planchetteMesh = new THREE.Mesh(cardGeo, cardMat);
      planchetteMesh.rotation.set(Math.PI / 2, 0, 0);
      planchetteMesh.position.set(0, -0.005, (boxD + 0.04) / 2);
      planchetteMesh.castShadow = true;
      lidHinge.add(planchetteMesh);
    }

