  <!-- JavaScript 3D Engine & Studio Logic -->
  <script>
    let scene, camera, renderer, controls;
    let boxGroup, lidHinge, flapHinge;
    let originalLidCanvasTexture, planchetteTexture;
    let autoRotate = false;
    let currentOpenProgress = 0;
    let targetOpenProgress = 0;

    let planchetteMesh, merchGroup;
    let currentCardRotation = 0;
    let currentLidRotation = 0;

    // Dimensions: 30 x 30 x 10 cm (1 unit = 10 cm)
    const boxW = 3.0;
    const boxD = 3.0;
    const boxH = 1.0;
    const wallThick = 0.024; // Calibre 40 (~2.4 mm)
    const flapH = 0.65;      // 6.5 cm front flap

    // Límites interiores para que los objetos queden dentro de la caja
    const bedTop = 0.07;
    const innerHalfW = boxW / 2 - wallThick - 0.03;
    const innerHalfD = boxD / 2 - wallThick - 0.03;
    const maxItemH = boxH - bedTop - 0.04;

    let boxMaterialProps = {
      color: 0x111215,
      roughness: 0.85,
      metalness: 0.08
    };

    let baseSideColor = 0x111215;
    let lidFlapColor = 0x111215;
    let currentFoil = 'none';

    let baseMaterial, baseSideMaterial, flapMaterial, lidTopMaterial, lidInnerMaterial;
    let currentClient = "Cliente General";

    // Custom Items State
    let customItemsList = [];
    let selectedItemIndex = 0;
    let bedMeshMaterial = null;

    const metalMatShared = new THREE.MeshStandardMaterial({ color: 0xd4af37, roughness: 0.25, metalness: 0.85 });

    // In-App Notification modal helper (Never native alert)
    function showAppModal(title, message) {
      const modal = document.getElementById('app-modal');
      const tEl = document.getElementById('modal-title');
      const mEl = document.getElementById('modal-message');
      if (!modal || !tEl || !mEl) return;
      tEl.innerText = title;
      mEl.innerText = message;
      modal.classList.remove('opacity-0', 'pointer-events-none');
    }

    function closeAppModal() {
      const modal = document.getElementById('app-modal');
      if (modal) modal.classList.add('opacity-0', 'pointer-events-none');
    }

    function switchSidebarTab(tabName) {
      const tabs = ['art', 'items', 'settings'];
      tabs.forEach(t => {
        const btn = document.getElementById(`tab-btn-${t}`);
        const content = document.getElementById(`tab-content-${t}`);
        if (btn && content) {
          if (t === tabName) {
            btn.className = 'py-1.5 text-xs font-bold rounded-lg bg-emerald-600 text-white shadow-sm transition';
            content.classList.remove('hidden');
          } else {
            btn.className = 'py-1.5 text-xs font-semibold rounded-lg text-slate-300 hover:text-white hover:bg-white/5 transition';
            content.classList.add('hidden');
          }
        }
      });
    }

    function createProceduralLidArtwork(clientName = currentClient) {
      const canvas = document.createElement('canvas');
      canvas.width = 2048;
      canvas.height = 2048;
      const ctx = canvas.getContext('2d');

      const radialGrad = ctx.createRadialGradient(1024, 1024, 100, 1024, 1024, 1100);
      radialGrad.addColorStop(0, '#1c222d');
      radialGrad.addColorStop(0.6, '#13151b');
      radialGrad.addColorStop(1, '#0b0c0f');
      ctx.fillStyle = radialGrad;
      ctx.fillRect(0, 0, canvas.width, canvas.height);

      ctx.strokeStyle = '#10b981';
      ctx.lineWidth = 10;
      ctx.strokeRect(60, 60, canvas.width - 120, canvas.height - 120);

      ctx.strokeStyle = 'rgba(255, 255, 255, 0.15)';
      ctx.lineWidth = 3;
      ctx.strokeRect(90, 90, canvas.width - 180, canvas.height - 180);

      function drawBracket(x, y, flipX, flipY) {
        ctx.save();
        ctx.translate(x, y);
        ctx.scale(flipX ? -1 : 1, flipY ? -1 : 1);
        ctx.strokeStyle = '#34d399';
        ctx.lineWidth = 8;
        ctx.beginPath();
        ctx.moveTo(110, 40);
        ctx.lineTo(40, 40);
        ctx.lineTo(40, 110);
        ctx.stroke();
        ctx.restore();
      }
      drawBracket(0, 0, false, false);
      drawBracket(canvas.width, 0, true, false);
      drawBracket(0, canvas.height, false, true);
      drawBracket(canvas.width, canvas.height, true, true);

      ctx.fillStyle = 'rgba(16, 185, 129, 0.15)';
      ctx.fillRect(canvas.width / 2 - 320, 240, 640, 70);
      ctx.strokeStyle = '#10b981';
      ctx.lineWidth = 2;
      ctx.strokeRect(canvas.width / 2 - 320, 240, 640, 70);

      ctx.fillStyle = '#6ee7b7';
      ctx.font = '700 30px "Inter", sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText('EDICIÓN PREMIUM • CARTÓN RÍGIDO CAL. 40', canvas.width / 2, 275);

      ctx.save();
      ctx.beginPath();
      ctx.arc(canvas.width / 2, 780, 170, 0, Math.PI * 2);
      ctx.strokeStyle = 'rgba(16, 185, 129, 0.4)';
      ctx.lineWidth = 14;
      ctx.stroke();

      ctx.beginPath();
      ctx.arc(canvas.width / 2, 780, 140, 0, Math.PI * 2);
      ctx.fillStyle = 'rgba(255, 255, 255, 0.04)';
      ctx.fill();
      ctx.strokeStyle = '#34d399';
      ctx.lineWidth = 4;
      ctx.stroke();

      ctx.fillStyle = '#ffffff';
      ctx.font = '900 130px "Inter", sans-serif';
      ctx.fillText('3D', canvas.width / 2, 785);
      ctx.restore();

      ctx.save();
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';

      ctx.fillStyle = '#ffffff';
      ctx.font = '900 110px "Inter", sans-serif';
      ctx.fillText(clientName.toUpperCase(), canvas.width / 2, 1140);

      ctx.fillStyle = '#94a3b8';
      ctx.font = '500 48px "Inter", sans-serif';
      ctx.fillText('EMPAQUE PERSONALIZADO', canvas.width / 2, 1260);

      ctx.font = '700 40px "Inter", monospace';
      ctx.fillStyle = '#34d399';
      ctx.fillText('30 × 30 × 10 CM  |  CIERRE IMANTADO', canvas.width / 2, 1680);
      ctx.restore();

      return canvas;
    }

    function init() {
      const container = document.getElementById('canvas-container');
      const width = container.clientWidth || window.innerWidth;
      const height = container.clientHeight || window.innerHeight;

      scene = new THREE.Scene();
      scene.background = new THREE.Color(0x0a0c10);

      camera = new THREE.PerspectiveCamera(40, width / height, 0.1, 100);
      camera.position.set(4.5, 4.0, 5.0);

      renderer = new THREE.WebGLRenderer({ antialias: true, preserveDrawingBuffer: true });
      renderer.setSize(width, height);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
      renderer.shadowMap.enabled = true;
      renderer.shadowMap.type = THREE.PCFSoftShadowMap;
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 1.15;
      container.appendChild(renderer.domElement);

      setupItemDragging();

      controls = new THREE.OrbitControls(camera, renderer.domElement);
      controls.enableDamping = true;
      controls.dampingFactor = 0.05;
      controls.maxPolarAngle = Math.PI / 2 + 0.05;
      controls.minDistance = 1.8;
      controls.maxDistance = 12.0;
      controls.target.set(0, 0.4, 0);

      const ambientLight = new THREE.AmbientLight(0xffffff, 0.8);
      scene.add(ambientLight);

      const keyLight = new THREE.DirectionalLight(0xfff7ed, 1.6);
      keyLight.position.set(5, 8, 4);
      keyLight.castShadow = true;
      keyLight.shadow.mapSize.width = 2048;
      keyLight.shadow.mapSize.height = 2048;
      keyLight.shadow.camera.near = 0.5;
      keyLight.shadow.camera.far = 25;
      keyLight.shadow.bias = -0.0001;
      const d = 3.5;
      keyLight.shadow.camera.left = -d;
      keyLight.shadow.camera.right = d;
      keyLight.shadow.camera.top = d;
      keyLight.shadow.camera.bottom = -d;
      scene.add(keyLight);

      const rimLight = new THREE.DirectionalLight(0xd1d5db, 0.7);
      rimLight.position.set(-6, 4, -4);
      scene.add(rimLight);

      const fillLight = new THREE.DirectionalLight(0xa7f3d0, 0.45);
      fillLight.position.set(0, -3, 5);
      scene.add(fillLight);

      const shadowPlaneGeo = new THREE.PlaneGeometry(14, 14);
      const shadowPlaneMat = new THREE.ShadowMaterial({ opacity: 0.45 });
      const shadowPlane = new THREE.Mesh(shadowPlaneGeo, shadowPlaneMat);
      shadowPlane.rotation.x = -Math.PI / 2;
      shadowPlane.position.y = -0.005;
      shadowPlane.receiveShadow = true;
      scene.add(shadowPlane);

      const floorCanvas = document.createElement('canvas');
      floorCanvas.width = 512;
      floorCanvas.height = 512;
      const fCtx = floorCanvas.getContext('2d');
      const grad = fCtx.createRadialGradient(256, 256, 40, 256, 256, 256);
      grad.addColorStop(0, '#1c1f27');
      grad.addColorStop(1, '#0a0c10');
      fCtx.fillStyle = grad;
      fCtx.fillRect(0, 0, 512, 512);

      const floorTex = new THREE.CanvasTexture(floorCanvas);
      const floorMat = new THREE.MeshBasicMaterial({ map: floorTex });
      const floorMesh = new THREE.Mesh(new THREE.PlaneGeometry(16, 16), floorMat);
      floorMesh.rotation.x = -Math.PI / 2;
      floorMesh.position.y = -0.01;
      scene.add(floorMesh);

      buildPackagingBox();

      window.addEventListener('resize', onWindowResize);
      setupDragAndDrop();
      setupItemSliderListeners();

      animate();
    }

    function buildPackagingBox() {
      boxGroup = new THREE.Group();
      scene.add(boxGroup);

      baseMaterial = new THREE.MeshStandardMaterial({
        color: boxMaterialProps.color,
        roughness: boxMaterialProps.roughness,
        metalness: boxMaterialProps.metalness
      });

      baseSideMaterial = new THREE.MeshStandardMaterial({
        color: baseSideColor,
