    function duplicateSelectedItem() {
      const it = customItemsList[selectedItemIndex];
      if (!it) return;
      createCustomItemFromData({
        name: `${it.name} (Copia)`,
        shapeType: it.shapeType,
        baseColor: it.baseColor,
        texture: it.texture,
        x: it.x + 0.2,
        z: it.z + 0.2,
        rotY: it.rotY,
        scale: it.scale,
        depth: it.depth,
        isStanding: it.isStanding,
        model: it.model,
        aspect: it.aspect
      });
      renderItemsStudioUI();
    }

    function removeSelectedItem() {
      if (selectedItemIndex < 0 || selectedItemIndex >= customItemsList.length) return;
      const removed = customItemsList.splice(selectedItemIndex, 1)[0];
      if (removed && removed.group && merchGroup) {
        merchGroup.remove(removed.group);
      }
      selectedItemIndex = Math.max(0, customItemsList.length - 1);
      renderItemsStudioUI();
    }

    function toggleItemStanding() {
      const item = customItemsList[selectedItemIndex];
      if (!item) return;
      item.isStanding = !item.isStanding;
      refitItem(item);
      syncSlidersWithSelectedItem();
    }

    function selectCustomItem(index) {
      if (index < 0 || index >= customItemsList.length) return;
      selectedItemIndex = index;
      syncSlidersWithSelectedItem();
      renderItemsStudioUI();
    }

    function renderItemsStudioUI() {
      const container = document.getElementById('items-list-pills');
      const countBadge = document.getElementById('custom-items-count');
      if (countBadge) {
        countBadge.innerText = `${customItemsList.length} elemento${customItemsList.length === 1 ? '' : 's'}`;
      }
      if (!container) return;
      container.innerHTML = '';

      customItemsList.forEach((item, index) => {
        const isSelected = index === selectedItemIndex;
        const btn = document.createElement('button');
        btn.className = `px-2.5 py-1 rounded-lg shrink-0 text-[11px] font-semibold transition active:scale-95 flex items-center gap-1 ${
          isSelected
            ? 'bg-emerald-600 text-white shadow-md shadow-emerald-600/30 border border-emerald-400'
            : 'bg-white/5 hover:bg-white/10 text-slate-300 border border-white/10'
        }`;
