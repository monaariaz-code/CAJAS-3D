<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Mockup 3D • Caja Libro Imantada</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Three.js and Ecosystem -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/controls/OrbitControls.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/GLTFLoader.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/three@0.128.0/examples/js/loaders/OBJLoader.js"></script>
  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Inter', sans-serif;
      overflow: hidden;
      user-select: none;
      background-color: #090b0e;
    }
    .custom-scrollbar::-webkit-scrollbar {
      width: 5px;
      height: 5px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
      background: rgba(255, 255, 255, 0.03);
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
      background: rgba(16, 185, 129, 0.35);
      border-radius: 9999px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
      background: rgba(16, 185, 129, 0.7);
    }
    canvas {
      outline: none;
      display: block;
    }
    .mono {
      font-family: 'JetBrains Mono', monospace;
    }
    @keyframes pulse-ring {
      0% { transform: scale(0.95); opacity: 0.8; }
      50% { transform: scale(1.15); opacity: 0.3; }
      100% { transform: scale(0.95); opacity: 0.8; }
    }
    .pulse-ring {
      animation: pulse-ring 2.5s infinite ease-in-out;
    }
  </style>
</head>
<body class="w-screen h-screen flex flex-col md:flex-row text-slate-100 overflow-hidden bg-[#090b0e]">

  <!-- 3D Canvas Area -->
  <main id="canvas-container" class="relative flex-1 h-[52vh] md:h-full w-full bg-gradient-to-b from-[#15181f] via-[#0d0f14] to-[#07080a] cursor-grab active:cursor-grabbing">

    <!-- Floating Top-Left Header -->
    <div class="absolute top-3 left-3 md:top-4 md:left-4 z-10 pointer-events-none flex items-center space-x-3 bg-black/80 backdrop-blur-md px-3.5 py-2 md:px-4 md:py-2.5 rounded-2xl border border-white/10 shadow-2xl">
      <div class="relative flex items-center justify-center">
        <div class="w-3.5 h-3.5 rounded-full bg-emerald-500 shadow-[0_0_12px_#10b981]"></div>
        <div class="absolute w-5 h-5 rounded-full bg-emerald-400/40 pulse-ring"></div>
      </div>
      <div>
        <h1 class="text-xs md:text-sm font-black tracking-wider uppercase text-white flex items-center gap-1.5">
          <span>Mockup 3D Pro</span>
          <span class="text-slate-500">•</span>
          <span id="header-client-name" class="text-emerald-400 truncate max-w-[140px] md:max-w-[200px]">Cliente General</span>
        </h1>
        <p class="text-[10px] md:text-[11px] text-slate-400">Caja Libro Imantada • 30×30×10 cm (Cartón Cal. 40)</p>
      </div>
    </div>

    <!-- Quick Camera Presets Toolbar -->
    <div class="absolute top-3 right-3 md:top-4 md:right-4 z-10 flex flex-wrap gap-1 bg-black/80 backdrop-blur-md p-1.5 rounded-xl border border-white/10 shadow-2xl">
      <button onclick="setCameraView('perspective')" class="px-2 py-1 text-[11px] font-medium rounded-lg hover:bg-white/10 active:scale-95 transition text-slate-300 hover:text-white">Perspectiva</button>
      <button onclick="setCameraView('top')" class="px-2 py-1 text-[11px] font-medium rounded-lg hover:bg-white/10 active:scale-95 transition text-slate-300 hover:text-white">Cenital</button>
      <button onclick="setCameraView('front')" class="px-2 py-1 text-[11px] font-medium rounded-lg hover:bg-white/10 active:scale-95 transition text-slate-300 hover:text-white">Frontal</button>
      <button onclick="setCameraView('side')" class="px-2 py-1 text-[11px] font-medium rounded-lg hover:bg-white/10 active:scale-95 transition text-slate-300 hover:text-white">Lateral</button>
      <button onclick="setCameraView('open')" class="px-2.5 py-1 text-[11px] font-bold rounded-lg bg-emerald-600/40 text-emerald-200 border border-emerald-500/50 hover:bg-emerald-600/60 active:scale-95 transition flex items-center gap-1 shadow-sm">
        <span>👁️</span> Abierta
      </button>
    </div>

    <!-- Bottom Controls Helper Hints -->
    <div class="absolute bottom-3 left-3 md:bottom-4 md:left-4 z-10 pointer-events-none text-[11px] text-slate-400 hidden sm:flex items-center gap-2 bg-black/75 backdrop-blur-sm px-3.5 py-1.5 rounded-xl border border-white/10 shadow-lg">
      <span>🖱️ Arrastrar: Rotar</span>
      <span class="text-white/20">•</span>
      <span>📜 Rueda: Zoom</span>
      <span class="text-white/20">•</span>
      <span>Clic Derecho: Trasladar</span>
      <span class="text-white/20">•</span>
      <span class="text-emerald-400 font-medium">Con caja abierta: arrastra objetos 3D directo en la bandeja</span>
    </div>

    <!-- Drag & Drop Overlay -->
    <div id="drop-zone-overlay" class="absolute inset-0 bg-emerald-950/80 border-4 border-dashed border-emerald-400 z-30 pointer-events-none flex items-center justify-center opacity-0 transition-opacity duration-200">
      <div class="bg-black/95 px-8 py-5 rounded-2xl border border-white/20 text-center shadow-2xl max-w-sm">
        <div class="text-4xl mb-2">📥</div>
        <p class="text-base font-bold text-emerald-300">Suelta tu imagen o modelo 3D</p>
        <p class="text-xs text-slate-300 mt-1">Imágenes aplicarán a la tapa superior. Archivos .glb/.obj se importarán como ítems interiores.</p>
      </div>
    </div>

    <!-- In-App Notification / Dialog Modal -->
    <div id="app-modal" class="absolute inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center p-4 opacity-0 pointer-events-none transition-opacity duration-200">
      <div class="bg-[#16181f] border border-white/15 max-w-md w-full p-5 rounded-2xl shadow-2xl text-left space-y-3">
        <div class="flex items-center gap-2.5 text-amber-400">
          <span class="text-xl">⚠️</span>
          <h3 id="modal-title" class="font-bold text-sm text-white">Notificación</h3>
        </div>
        <p id="modal-message" class="text-xs text-slate-300 leading-relaxed">Mensaje del sistema</p>
        <div class="flex justify-end pt-2">
          <button onclick="closeAppModal()" class="px-4 py-1.5 bg-emerald-600 hover:bg-emerald-500 active:scale-95 text-white font-semibold text-xs rounded-lg transition">
            Entendido
          </button>
        </div>
      </div>
    </div>
  </main>

  <!-- Sidebar Configuration Panel -->
  <aside id="sidebar-panel" class="w-full md:w-[430px] h-[48vh] md:h-full bg-[#111317] border-t md:border-t-0 md:border-l border-white/10 flex flex-col justify-between overflow-hidden shadow-2xl z-20">

    <!-- Top Fixed Header inside Sidebar -->
    <div class="p-4 border-b border-white/10 shrink-0 bg-black/40 space-y-2.5">
      <div class="flex items-center justify-between">
        <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-semibold bg-emerald-500/20 text-emerald-400 border border-emerald-500/30">
          Caja Libro Imantada • Calibre 40
        </span>
        <span class="text-[11px] mono text-slate-400">30×30×10 cm</span>
      </div>

      <!-- Quick Client input -->
      <div class="flex gap-1.5">
        <input type="text" id="client-name-input" value="Cliente General" placeholder="Nombre de cliente o marca..." class="w-full px-2.5 py-1.5 bg-white/5 border border-white/15 rounded-lg text-xs text-white placeholder-slate-500 focus:outline-none focus:border-emerald-500 transition">
        <button onclick="saveClientNameFromInput()" class="px-3 py-1.5 bg-emerald-600 hover:bg-emerald-500 active:scale-95 text-xs font-semibold rounded-lg text-white transition whitespace-nowrap shadow-sm">
          Aplicar
        </button>
      </div>

      <!-- Section Navigation Tabs -->
      <div class="grid grid-cols-3 gap-1 bg-white/5 p-1 rounded-xl border border-white/5">
        <button id="tab-btn-art" onclick="switchSidebarTab('art')" class="py-1.5 text-xs font-bold rounded-lg bg-emerald-600 text-white shadow-sm transition">
          🎨 Artes Caja
        </button>
        <button id="tab-btn-items" onclick="switchSidebarTab('items')" class="py-1.5 text-xs font-semibold rounded-lg text-slate-300 hover:text-white hover:bg-white/5 transition">
          🎁 Artículos 3D
        </button>
        <button id="tab-btn-settings" onclick="switchSidebarTab('settings')" class="py-1.5 text-xs font-semibold rounded-lg text-slate-300 hover:text-white hover:bg-white/5 transition">
          ⚙️ Ajustes
        </button>
      </div>
    </div>

    <!-- Scrollable Content per Tab -->
    <div class="flex-1 overflow-y-auto custom-scrollbar p-4 space-y-4">

      <!-- TAB 1: ARTES DE LA CAJA (LID, SIDES, FLAP, CONTRATAPA) -->
      <div id="tab-content-art" class="space-y-3.5">

        <!-- 1. Arte Tapa Exterior -->
        <div class="bg-white/5 p-3.5 rounded-xl border border-white/10 space-y-2.5 shadow-sm">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-1.5">
              <span class="text-sm">🖼️</span>
              <span class="text-xs font-bold text-white uppercase tracking-wide">Tapa Superior (Exterior)</span>
            </div>
            <span id="lid-source-badge" class="text-[10px] px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-medium">Prediseño</span>
          </div>

          <div class="flex items-center gap-1.5">
            <label class="flex-1 cursor-pointer flex items-center justify-center gap-2 py-2 px-3 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold rounded-lg transition text-xs shadow-md active:scale-95">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              <span>Subir Archivo de Tapa</span>
              <input type="file" id="upload-lid" accept="image/*" class="hidden">
            </label>
            <button onclick="rotateLidTexture()" title="Rotar 90° orientación" class="px-2.5 py-2 text-xs bg-white/10 hover:bg-white/15 border border-white/10 rounded-lg text-slate-200 hover:text-white transition active:scale-95 font-semibold">
              🔄 90°
            </button>
            <button onclick="restoreDefaultLid()" title="Restaurar diseño predeterminado" class="px-2.5 py-2 text-xs bg-white/10 hover:bg-white/15 border border-white/10 rounded-lg text-slate-300 hover:text-white transition active:scale-95 font-semibold">
              ↺ Reset
            </button>
          </div>
          <p class="text-[10px] text-slate-400">Acepta archivos JPG, PNG de alta definición. También puedes arrastrar la imagen directamente al visor 3D.</p>
        </div>

        <!-- 2. Arte Interior (Contratapa) -->
        <div class="bg-emerald-950/20 border border-emerald-500/30 p-3.5 rounded-xl space-y-2.5 shadow-sm">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-1.5">
              <span class="text-sm">🪞</span>
              <span class="text-xs font-bold text-emerald-300 uppercase tracking-wide">Arte Interior (Contratapa)</span>
            </div>
            <span id="card-source-badge" class="text-[10px] px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-medium">Prediseño</span>
          </div>

          <div class="flex items-center gap-1.5">
            <label class="flex-1 cursor-pointer flex items-center justify-center gap-2 py-2 px-3 bg-emerald-600 hover:bg-emerald-500 text-white font-semibold rounded-lg transition text-xs shadow-md active:scale-95">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
              <span>Subir Arte Contratapa</span>
              <input type="file" id="upload-card" accept="image/*" class="hidden">
            </label>
            <button onclick="rotateCardTexture()" title="Rotar 90° arte interno" class="px-2.5 py-2 text-xs bg-white/10 hover:bg-white/15 border border-white/10 rounded-lg text-slate-200 hover:text-white transition active:scale-95 font-semibold">
              🔄 90°
            </button>
            <button onclick="restoreDefaultCard()" title="Restaurar diseño interior predeterminado" class="px-2.5 py-2 text-xs bg-white/10 hover:bg-white/15 border border-white/10 rounded-lg text-slate-300 hover:text-white transition active:scale-95 font-semibold">
              ↺ Reset
            </button>
          </div>
          <p class="text-[10px] text-slate-400">Visible al abrir la caja. Se adapta de forma proporcional a la cara interna de la tapa.</p>
        </div>

        <!-- 3. Laterales de la Caja (Base) -->
        <div class="bg-white/5 p-3 rounded-xl border border-white/10 space-y-2">
          <div class="flex items-center justify-between">
            <label class="text-xs text-slate-200 font-bold uppercase tracking-wider">Laterales de la Base</label>
            <span id="badge-lateral" class="text-[10px] text-slate-300 mono">Negro Mate</span>
          </div>

          <div class="grid grid-cols-3 gap-1.5 text-xs">
            <button id="btn-lateral-black" onclick="setBaseSideColor('#111215')" class="py-1 px-2 rounded-lg bg-emerald-600/30 text-emerald-200 border border-emerald-500/40 font-medium flex items-center justify-center gap-1 active:scale-95 transition">
              <span class="w-2.5 h-2.5 rounded-full bg-black border border-white/30"></span> Negro
            </button>
            <button id="btn-lateral-red" onclick="setBaseSideColor('#b91c1c')" class="py-1 px-2 rounded-lg bg-white/5 hover:bg-white/10 text-slate-300 font-medium flex items-center justify-center gap-1 border border-white/10 active:scale-95 transition">
              <span class="w-2.5 h-2.5 rounded-full bg-red-600"></span> Rojo
            </button>
            <label class="py-1 px-2 rounded-lg bg-white/5 hover:bg-white/10 text-slate-300 font-medium flex items-center justify-center gap-1 border border-white/10 cursor-pointer text-center active:scale-95 transition">
              🎨 Color
              <input type="color" value="#111215" onchange="setBaseSideColor(this.value)" class="sr-only">
            </label>
          </div>

          <label class="w-full cursor-pointer flex items-center justify-center gap-2 py-1.5 px-3 bg-black/40 hover:bg-black/60 border border-white/15 border-dashed rounded-lg transition text-xs text-slate-300 hover:text-white">
            <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            <span>Subir Gráfica Lateral (PNG/JPG)</span>
            <input type="file" id="upload-sides" accept="image/*" class="hidden">
          </label>
        </div>

        <!-- 4. Solapa Frontal Imantada -->
        <div class="bg-white/5 p-3 rounded-xl border border-white/10 space-y-2">
          <div class="flex items-center justify-between">
            <label class="text-xs text-slate-200 font-bold uppercase tracking-wider">Solapa Frontal Imantada</label>
            <span id="badge-flaps" class="text-[10px] text-slate-400 mono">Negro Mate</span>
          </div>

          <div class="grid grid-cols-3 gap-1.5 text-xs">
            <button id="btn-flap-black" onclick="setFlapColor('#111215')" class="py-1 px-2 rounded-lg bg-emerald-600/30 text-emerald-200 border border-emerald-500/40 font-medium flex items-center justify-center gap-1 active:scale-95 transition">
              <span class="w-2.5 h-2.5 rounded-full bg-black border border-white/30"></span> Negro
            </button>
            <button id="btn-flap-red" onclick="setFlapColor('#b91c1c')" class="py-1 px-2 rounded-lg bg-white/5 hover:bg-white/10 text-slate-300 font-medium flex items-center justify-center gap-1 border border-white/10 active:scale-95 transition">
              <span class="w-2.5 h-2.5 rounded-full bg-red-600"></span> Rojo
            </button>
            <label class="py-1 px-2 rounded-lg bg-white/5 hover:bg-white/10 text-slate-300 font-medium flex items-center justify-center gap-1 border border-white/10 cursor-pointer text-center active:scale-95 transition">
              🎨 Color
              <input type="color" value="#111215" onchange="setFlapColor(this.value)" class="sr-only">
            </label>
          </div>

          <label class="w-full cursor-pointer flex items-center justify-center gap-2 py-1.5 px-3 bg-black/40 hover:bg-black/60 border border-white/15 border-dashed rounded-lg transition text-xs text-slate-300 hover:text-white">
            <svg class="w-3.5 h-3.5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
            <span>Subir Gráfica Solapa (PNG/JPG)</span>
            <input type="file" id="upload-flaps" accept="image/*" class="hidden">
          </label>
        </div>
      </div>

      <!-- TAB 2: ARTÍCULOS INTERIORES 3D (GORRAS, BOTELLAS, SILUETAS, MODELOS) -->
      <div id="tab-content-items" class="space-y-4 hidden">

        <!-- Creator Buttons -->
        <div class="space-y-2">
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-bold uppercase tracking-wider text-emerald-400 flex items-center gap-1.5">
              <span>🎁</span> Agregar Objetos Interiores
            </h3>
            <span id="custom-items-count" class="text-[10px] px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-300 font-medium">0 elementos</span>
          </div>

          <div class="grid grid-cols-3 gap-1.5">
            <button onclick="addPreset3DItem('cap')" class="flex flex-col items-center justify-center py-2 px-1 bg-emerald-600/20 hover:bg-emerald-600/30 border border-emerald-500/40 text-emerald-300 rounded-lg transition text-xs font-semibold active:scale-95">
              <span class="text-base">🧢</span>
              <span>+ Gorra 3D</span>
            </button>
            <button onclick="addPreset3DItem('bottle')" class="flex flex-col items-center justify-center py-2 px-1 bg-emerald-600/20 hover:bg-emerald-600/30 border border-emerald-500/40 text-emerald-300 rounded-lg transition text-xs font-semibold active:scale-95">
              <span class="text-base">🍾</span>
              <span>+ Botella 3D</span>
            </button>
            <button onclick="addPreset3DItem('mug')" class="flex flex-col items-center justify-center py-2 px-1 bg-emerald-600/20 hover:bg-emerald-600/30 border border-emerald-500/40 text-emerald-300 rounded-lg transition text-xs font-semibold active:scale-95">
              <span class="text-base">☕</span>
              <span>+ Taza 3D</span>
            </button>
            <label class="cursor-pointer flex flex-col items-center justify-center py-2 px-1 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg transition text-xs font-semibold shadow-md active:scale-95 text-center">
              <span class="text-base">✂️</span>
              <span>+ Imagen PNG</span>
              <input type="file" id="upload-custom-item" accept="image/*" multiple class="hidden">
            </label>
            <label class="cursor-pointer flex flex-col items-center justify-center py-2 px-1 bg-emerald-600/20 hover:bg-emerald-600/30 border border-emerald-500/40 text-emerald-300 rounded-lg transition text-xs font-semibold active:scale-95 text-center col-span-2">
              <span class="text-base">🧊</span>
              <span>+ Importar Modelo 3D (.glb, .gltf, .obj)</span>
              <input type="file" id="upload-model-item" accept=".glb,.gltf,.obj" multiple class="hidden">
            </label>
          </div>

          <!-- Quick Kits -->
          <div class="flex items-center gap-1.5 pt-1 overflow-x-auto custom-scrollbar text-[10px]">
            <span class="text-slate-400 shrink-0 font-medium">Kits:</span>
            <button onclick="loadTemplateKit('caps')" class="px-2 py-0.5 rounded bg-white/5 hover:bg-white/10 border border-white/10 text-slate-300 shrink-0 active:scale-95 transition">🧢 Gorra + Termo</button>
            <button onclick="loadTemplateKit('fashion')" class="px-2 py-0.5 rounded bg-white/5 hover:bg-white/10 border border-white/10 text-slate-300 shrink-0 active:scale-95 transition">👕 Moda Urbana</button>
            <button onclick="loadTemplateKit('tech')" class="px-2 py-0.5 rounded bg-white/5 hover:bg-white/10 border border-white/10 text-slate-300 shrink-0 active:scale-95 transition">📱 Tech Kit</button>
            <button onclick="loadTemplateKit('cafe')" class="px-2 py-0.5 rounded bg-white/5 hover:bg-white/10 border border-white/10 text-slate-300 shrink-0 active:scale-95 transition">☕ Kit Café</button>
            <button onclick="loadTemplateKit('empty')" class="px-2 py-0.5 rounded bg-white/5 hover:bg-white/10 border border-white/10 text-slate-400 shrink-0 active:scale-95 transition">🗑️ Vaciar</button>
          </div>
        </div>

        <!-- Items Selection Pills -->
        <div>
          <label class="text-[10px] font-semibold text-slate-400 block mb-1">Seleccionar objeto para editar o transformar:</label>
          <div id="items-list-pills" class="flex gap-1.5 overflow-x-auto pb-1 custom-scrollbar text-xs">
            <!-- Dynamically populated -->
          </div>
        </div>

        <!-- Inspector for Selected Item -->
        <div id="item-inspector-container" class="space-y-3 bg-black/50 p-3.5 rounded-xl border border-white/10 shadow-lg">
          <div class="flex items-center justify-between border-b border-white/10 pb-2">
            <span id="inspector-item-title" class="text-xs font-bold text-white truncate max-w-[170px]">Objeto</span>
            <div class="flex items-center gap-1">
              <button onclick="duplicateSelectedItem()" title="Duplicar objeto" class="p-1.5 text-slate-300 hover:text-white rounded bg-white/10 hover:bg-white/20 border border-white/10 active:scale-95 text-xs">📋</button>
              <button onclick="removeSelectedItem()" title="Eliminar de la caja" class="p-1.5 text-red-300 hover:text-red-200 rounded bg-red-950/40 hover:bg-red-900/60 border border-red-500/40 active:scale-95 text-xs">🗑️</button>
            </div>
          </div>

          <!-- Highlighted Texture Replacement Button -->
          <div class="bg-emerald-950/30 border border-emerald-500/40 p-2.5 rounded-lg space-y-1.5">
