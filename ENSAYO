    }

    function processImageFile(file) {
      if (!file || !file.type.startsWith('image/')) return;
      const reader = new FileReader();
      reader.onload = function (event) {
        const img = new Image();
        img.onload = function () {
          applyLidTextureFromImage(img);
        };
        img.src = event.target.result;
      };
      reader.readAsDataURL(file);
    }

    document.getElementById('upload-lid').addEventListener('change', function (e) {
      if (e.target.files && e.target.files[0]) {
        processImageFile(e.target.files[0]);
      }
    });

    document.getElementById('upload-sides').addEventListener('change', function (e) {
      if (e.target.files && e.target.files[0]) {
        const reader = new FileReader();
        reader.onload = function (ev) {
          const img = new Image();
          img.onload = function () {
            const tex = new THREE.Texture(img);
            tex.encoding = THREE.sRGBEncoding;
            tex.needsUpdate = true;
            baseSideMaterial.map = tex;
            baseSideMaterial.color.setHex(0xffffff);
            baseSideMaterial.needsUpdate = true;
          };
          img.src = ev.target.result;
        };
        reader.readAsDataURL(e.target.files[0]);
      }
    });

    document.getElementById('upload-flaps').addEventListener('change', function (e) {
      if (e.target.files && e.target.files[0]) {
        const file = e.target.files[0];
        if (!file.type.startsWith('image/')) return;
        const reader = new FileReader();
        reader.onload = function (ev) {
          const img = new Image();
          img.onload = function () {
            const tex = new THREE.Texture(img);
            tex.encoding = THREE.sRGBEncoding;
            tex.needsUpdate = true;
            flapMaterial.map = tex;
            flapMaterial.color.setHex(0xffffff);
            flapMaterial.needsUpdate = true;
          };
          img.src = ev.target.result;
        };
        reader.readAsDataURL(file);
      }
    });

    document.getElementById('upload-card').addEventListener('change', function (e) {
      if (e.target.files && e.target.files[0]) {
        const file = e.target.files[0];
        if (!file.type.startsWith('image/')) return;
        const reader = new FileReader();
        reader.onload = function (ev) {
          const img = new Image();
          img.onload = function () {
            applyCardTextureFromImage(img);
          };
          img.src = ev.target.result;
        };
        reader.readAsDataURL(file);
      }
    });

    function setupDragAndDrop() {
      const overlay = document.getElementById('drop-zone-overlay');
      window.addEventListener('dragover', (e) => {
        e.preventDefault();
        if (overlay) overlay.style.opacity = '1';
      });
      window.addEventListener('dragleave', (e) => {
        if (e.target === document.body || e.clientY <= 0) {
          if (overlay) overlay.style.opacity = '0';
        }
      });
      window.addEventListener('drop', (e) => {
        e.preventDefault();
        if (overlay) overlay.style.opacity = '0';
        if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length) {
          const first = e.dataTransfer.files[0];
          const ext = first.name.split('.').pop().toLowerCase();
          if (['glb', 'gltf', 'obj'].includes(ext)) {
            handleModelFileUpload(e.dataTransfer.files);
          } else if (first.type.startsWith('image/')) {
            processImageFile(first);
          }
        }
      });
    }

    function setCameraView(preset) {
      if (!controls) return;
      const duration = 700;
      let targetPos, targetLookAt;

      switch (preset) {
        case 'perspective':
          targetPos = new THREE.Vector3(4.2, 3.8, 4.8);
          targetLookAt = new THREE.Vector3(0, 0.5, 0);
          setLidOpenProgress(0);
          break;
        case 'top':
          targetPos = new THREE.Vector3(0.01, 6.2, 0);
          targetLookAt = new THREE.Vector3(0, 0.5, 0);
          setLidOpenProgress(0);
          break;
        case 'front':
          targetPos = new THREE.Vector3(0, 1.4, 5.5);
          targetLookAt = new THREE.Vector3(0, 0.6, 0);
          setLidOpenProgress(0);
          break;
        case 'side':
          targetPos = new THREE.Vector3(5.5, 1.4, 0);
          targetLookAt = new THREE.Vector3(0, 0.6, 0);
          setLidOpenProgress(0);
          break;
        case 'open':
          targetPos = new THREE.Vector3(0, 2.8, 4.8);
          targetLookAt = new THREE.Vector3(0, 1.2, -0.3);
          setLidOpenProgress(100);
          break;
      }

      animateCameraTo(targetPos, targetLookAt, duration);
    }

    function animateCameraTo(targetPosition, targetTarget, duration) {
      const startPosition = camera.position.clone();
      const startTarget = controls.target.clone();
      const startTime = performance.now();

      function update() {
        const elapsed = performance.now() - startTime;
        const progress = Math.min(elapsed / duration, 1.0);
        const ease = 1 - Math.pow(1 - progress, 3);

        camera.position.lerpVectors(startPosition, targetPosition, ease);
        controls.target.lerpVectors(startTarget, targetTarget, ease);
        controls.update();

        if (progress < 1.0) {
          requestAnimationFrame(update);
        }
      }
      requestAnimationFrame(update);
    }

    function captureRender() {
      renderer.render(scene, camera);
      const dataURL = renderer.domElement.toDataURL('image/png');
      const link = document.createElement('a');
      const safeName = currentClient.replace(/[^a-zA-Z0-9_-]/g, '_');
      link.download = `Mockup_3D_${safeName}.png`;
      link.href = dataURL;
      link.click();

      const toast = document.getElementById('toast');
      if (toast) {
        toast.classList.remove('hidden');
        setTimeout(() => toast.classList.add('hidden'), 2500);
      }
    }

    function onWindowResize() {
      const container = document.getElementById('canvas-container');
      const w = container.clientWidth;
      const h = container.clientHeight;
      camera.aspect = w / h;
      camera.updateProjectionMatrix();
      renderer.setSize(w, h);
    }

    function animate() {
      requestAnimationFrame(animate);

      currentOpenProgress += (targetOpenProgress - currentOpenProgress) * 0.1;

      if (lidHinge && flapHinge) {
        const maxLidAngle = -1.92;
        lidHinge.rotation.x = currentOpenProgress * maxLidAngle;
        flapHinge.rotation.x = currentOpenProgress * 0.65;
      }

      if (autoRotate && boxGroup && !draggingItem) {
        boxGroup.rotation.y += 0.007;
      }

      controls.update();
      renderer.render(scene, camera);
    }

    window.onload = function () {
      init();
    };
  </script>
</body>
</html>
