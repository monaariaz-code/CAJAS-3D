      if (!files || !files.length) return;

      Array.from(files).forEach((file, idx) => {
        if (!file.type.startsWith('image/')) return;
        const reader = new FileReader();
        reader.onload = function(e) {
          const img = new Image();
          img.onload = function() {
            const aspect = img.width / img.height;
            const tex = new THREE.Texture(img);
            tex.encoding = THREE.sRGBEncoding;
            tex.anisotropy = 16;
            tex.needsUpdate = true;

            const offset = (idx * 0.3) - 0.3;

            createCustomItemFromData({
              name: file.name.substring(0, 14),
              shapeType: "image",
              baseColor: "#111215",
              texture: tex,
              x: Math.max(-0.9, Math.min(0.9, offset)),
              z: Math.max(-0.9, Math.min(0.9, offset * 0.8)),
              rotY: (Math.random() - 0.5) * 0.4,
              scale: 0.95,
              depth: 0.06,
              isStanding: false,
              aspect: aspect,
              artName: file.name.substring(0, 10)
