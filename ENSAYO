    function buildCushionBed() {
      const fillerCanvas = document.createElement('canvas');
      fillerCanvas.width = 256;
      fillerCanvas.height = 256;
      const fctx = fillerCanvas.getContext('2d');
      fctx.fillStyle = '#101216';
      fctx.fillRect(0, 0, 256, 256);
      for (let i = 0; i < 200; i++) {
        fctx.strokeStyle = Math.random() > 0.5 ? '#222630' : '#161920';
        fctx.lineWidth = 2 + Math.random() * 2;
        fctx.beginPath();
        const sx = Math.random() * 256;
        const sy = Math.random() * 256;
        fctx.moveTo(sx, sy);
        fctx.lineTo(sx + (Math.random() - 0.5) * 40, sy + (Math.random() - 0.5) * 40);
        fctx.stroke();
      }
      const fillerTexture = new THREE.CanvasTexture(fillerCanvas);
      fillerTexture.wrapS = THREE.RepeatWrapping;
      fillerTexture.wrapT = THREE.RepeatWrapping;
      fillerTexture.repeat.set(4, 4);

      bedMeshMaterial = new THREE.MeshStandardMaterial({
        map: fillerTexture,
        roughness: 0.95,
        metalness: 0.05
      });

      const bedMesh = new THREE.Mesh(
        new THREE.BoxGeometry(boxW - 0.08, 0.06, boxD - 0.08),
        bedMeshMaterial
      );
      bedMesh.position.set(0, 0.04, 0);
      bedMesh.receiveShadow = true;
      merchGroup.add(bedMesh);
    }

    function createDefaultItemTexture(title = "PRODUCTO") {
      const c = document.createElement('canvas');
      c.width = 512;
      c.height = 512;
      const ctx = c.getContext('2d');

      const grad = ctx.createLinearGradient(0, 0, 512, 512);
      grad.addColorStop(0, '#10b981');
      grad.addColorStop(1, '#047857');
      ctx.fillStyle = grad;
      ctx.fillRect(0, 0, 512, 512);

      ctx.strokeStyle = '#ffffff';
      ctx.lineWidth = 14;
      ctx.strokeRect(30, 30, 452, 452);

      ctx.fillStyle = '#ffffff';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.font = '900 48px "Inter", sans-serif';
      ctx.fillText(title.toUpperCase(), 256, 230);

      ctx.font = '600 24px "Inter", sans-serif';
      ctx.fillStyle = '#d1fae5';
      ctx.fillText('EDICIÓN CLIENTE', 256, 290);

      const tex = new THREE.CanvasTexture(c);
      tex.encoding = THREE.sRGBEncoding;
      return tex;
    }

    function createVolumetricItemMesh(shapeType, texture, baseColorHex, depth, aspect = 1.0, model = null) {
      const group = new THREE.Group();
      const colorVal = parseInt(baseColorHex.replace('#', '0x'), 16);

      if (shapeType === 'cap') {
        const capFabricMat = new THREE.MeshStandardMaterial({
          color: colorVal,
          roughness: 0.85,
          metalness: 0.05
        });

        const crownGeo = new THREE.SphereGeometry(0.55, 32, 24, 0, Math.PI * 2, 0, Math.PI * 0.52);
        const crownMesh = new THREE.Mesh(crownGeo, capFabricMat);
        crownMesh.scale.set(1.0, 0.72, 1.08);
        crownMesh.position.y = 0.05;
        crownMesh.castShadow = true;
        crownMesh.receiveShadow = true;
        group.add(crownMesh);

        const visorShape = new THREE.Shape();
        visorShape.moveTo(-0.5, 0);
        visorShape.quadraticCurveTo(-0.55, 0.65, 0, 0.75);
        visorShape.quadraticCurveTo(0.55, 0.65, 0.5, 0);
        visorShape.quadraticCurveTo(0, 0.15, -0.5, 0);

        const visorExtrudeGeo = new THREE.ExtrudeGeometry(visorShape, {
          depth: 0.03,
          bevelEnabled: true,
          bevelSegments: 2,
          steps: 1,
          bevelSize: 0.01,
          bevelThickness: 0.01
        });
        const visorMesh = new THREE.Mesh(visorExtrudeGeo, capFabricMat);
        visorMesh.rotation.x = -Math.PI / 2 - 0.12;
        visorMesh.position.set(0, 0.08, 0.35);
        visorMesh.scale.set(1.05, 1.15, 1.0);
        visorMesh.castShadow = true;
        group.add(visorMesh);

        const buttonMesh = new THREE.Mesh(new THREE.CylinderGeometry(0.045, 0.045, 0.03, 16), capFabricMat);
        buttonMesh.position.set(0, 0.44, 0);
        group.add(buttonMesh);

        const patchGeo = new THREE.PlaneGeometry(0.48, 0.32);
        const patchMat = new THREE.MeshStandardMaterial({
          map: texture,
          transparent: true,
          roughness: 0.4,
          metalness: 0.1
        });
        const patchMesh = new THREE.Mesh(patchGeo, patchMat);
        patchMesh.position.set(0, 0.28, 0.55);
        patchMesh.rotation.x = -0.25;
        group.add(patchMesh);

      } else if (shapeType === 'bottle') {
        const bottleMat = new THREE.MeshStandardMaterial({
          color: colorVal,
          roughness: 0.3,
          metalness: 0.25
        });

        const bodyGeo = new THREE.CylinderGeometry(0.24, 0.24, 1.15, 32);
        const bodyMesh = new THREE.Mesh(bodyGeo, bottleMat);
        bodyMesh.castShadow = true;
        bodyMesh.receiveShadow = true;
        group.add(bodyMesh);

        const shoulderGeo = new THREE.CylinderGeometry(0.12, 0.24, 0.18, 32);
        const shoulderMesh = new THREE.Mesh(shoulderGeo, bottleMat);
        shoulderMesh.position.y = 0.66;
        shoulderMesh.castShadow = true;
        group.add(shoulderMesh);

        const neckGeo = new THREE.CylinderGeometry(0.11, 0.11, 0.14, 32);
        const neckMesh = new THREE.Mesh(neckGeo, bottleMat);
        neckMesh.position.y = 0.82;
        group.add(neckMesh);

        const capGeo = new THREE.CylinderGeometry(0.13, 0.13, 0.16, 32);
        const capMesh = new THREE.Mesh(capGeo, metalMatShared);
        capMesh.position.y = 0.96;
        capMesh.castShadow = true;
        group.add(capMesh);

        const labelGeo = new THREE.CylinderGeometry(0.244, 0.244, 0.72, 32, 1, true, -Math.PI * 0.8, Math.PI * 1.6);
        const labelMat = new THREE.MeshStandardMaterial({
          map: texture,
          roughness: 0.3,
          metalness: 0.05,
          side: THREE.DoubleSide
        });
        const labelMesh = new THREE.Mesh(labelGeo, labelMat);
        labelMesh.position.y = 0;
        group.add(labelMesh);

      } else if (shapeType === 'cutout') {
        const w = 1.3 * (aspect >= 1 ? 1 : aspect);
        const h = 1.3 * (aspect >= 1 ? 1 / aspect : 1);
        const d = Math.max(0.02, depth || 0.06);

        const cutoutGeo = new THREE.BoxGeometry(w, d, h);
        const sideMat = new THREE.MeshStandardMaterial({ color: colorVal, roughness: 0.6, metalness: 0.1 });
        const faceMat = new THREE.MeshStandardMaterial({
          map: texture,
          transparent: true,
          alphaTest: 0.15,
          roughness: 0.35,
          metalness: 0.1,
          side: THREE.DoubleSide
        });

        const materials = [sideMat, sideMat, faceMat, faceMat, sideMat, sideMat];
        const cutoutMesh = new THREE.Mesh(cutoutGeo, materials);
        cutoutMesh.castShadow = true;
        cutoutMesh.receiveShadow = true;
        group.add(cutoutMesh);

      } else if (shapeType === 'image') {
        const w = 1.3 * (aspect >= 1 ? 1 : aspect);
        const h = 1.3 * (aspect >= 1 ? 1 / aspect : 1);
        const imgMat = new THREE.MeshStandardMaterial({
          map: texture,
          transparent: true,
          alphaTest: 0.1,
          roughness: 0.6,
          metalness: 0.0,
          side: THREE.DoubleSide
        });
        const plane = new THREE.Mesh(new THREE.PlaneGeometry(w, h), imgMat);
        plane.castShadow = true;
        plane.receiveShadow = true;
        group.add(plane);

      } else if (shapeType === 'model' && model) {
        const inner = model.clone(true);
        inner.traverse(c => { if (c.isMesh) { c.castShadow = true; c.receiveShadow = true; } });
        const box = new THREE.Box3().setFromObject(inner);
        const size = box.getSize(new THREE.Vector3());
        inner.scale.multiplyScalar(1.0 / Math.max(size.x, size.y, size.z, 0.0001));
        const c2 = new THREE.Box3().setFromObject(inner).getCenter(new THREE.Vector3());
        inner.position.sub(c2);
        group.add(inner);

      } else if (shapeType === 'mug') {
        const mugMat = new THREE.MeshStandardMaterial({ color: colorVal, roughness: 0.35, metalness: 0.1 });

        const body = new THREE.Mesh(new THREE.CylinderGeometry(0.3, 0.27, 0.65, 40), mugMat);
        body.castShadow = true;
        body.receiveShadow = true;
        group.add(body);

        const handle = new THREE.Mesh(new THREE.TorusGeometry(0.17, 0.04, 12, 24, Math.PI), mugMat);
        handle.rotation.z = -Math.PI / 2;
        handle.position.set(0.29, 0, 0);
        handle.castShadow = true;
        group.add(handle);

        const labelMat = new THREE.MeshStandardMaterial({ map: texture, roughness: 0.3, side: THREE.DoubleSide });
        const label = new THREE.Mesh(
          new THREE.CylinderGeometry(0.301, 0.274, 0.4, 40, 1, true, Math.PI * 0.2, Math.PI * 1.2),
          labelMat
        );
        group.add(label);

      } else {
        const w = 1.2 * (aspect >= 1 ? 1 : aspect);
        const h = 1.2 * (aspect >= 1 ? 1 / aspect : 1);
        const d = Math.max(0.08, depth || 0.16);

        const boxGeo = new THREE.BoxGeometry(w, d, h);
        const sideMat = new THREE.MeshStandardMaterial({ color: colorVal, roughness: 0.7 });
        const topMat = new THREE.MeshStandardMaterial({ map: texture, roughness: 0.35, metalness: 0.05 });
        const materials = [sideMat, sideMat, topMat, sideMat, sideMat, sideMat];
        const boxMesh = new THREE.Mesh(boxGeo, materials);
        boxMesh.castShadow = true;
        boxMesh.receiveShadow = true;
        group.add(boxMesh);
      }

      return group;
    }

    function applyItemOrientation(item) {
      const m = item.meshGroup;
      m.rotation.set(0, 0, 0);
      if (item.shapeType === 'bottle') {
        if (!item.isStanding) m.rotation.z = Math.PI / 2;
      } else if (item.shapeType === 'image') {
        if (!item.isStanding) m.rotation.x = -Math.PI / 2;
      } else if (item.isStanding) {
        m.rotation.x = -Math.PI / 3;
      }
    }

    function refitItem(item) {
      if (!item || !item.group || !boxGroup) return;
      applyItemOrientation(item);

      const savedRot = boxGroup.rotation.y;
      boxGroup.rotation.y = 0;
      const g = item.group;
      g.rotation.y = item.rotY;

      for (let i = 0; i < 3; i++) {
        g.scale.setScalar(item.scale);
        g.position.set(0, 0, 0);
        boxGroup.updateMatrixWorld(true);
        const size = new THREE.Box3().setFromObject(g).getSize(new THREE.Vector3());
        const k = Math.min(1, maxItemH / size.y, (innerHalfW * 2) / size.x, (innerHalfD * 2) / size.z);
        if (k >= 0.999) break;
        item.scale = Math.max(0.1, item.scale * k);
      }

      g.scale.setScalar(item.scale);
      g.position.set(0, 0, 0);
      boxGroup.updateMatrixWorld(true);
      const bb = new THREE.Box3().setFromObject(g);
      const cx = (bb.min.x + bb.max.x) / 2;
      const cz = (bb.min.z + bb.max.z) / 2;
      const hx = (bb.max.x - bb.min.x) / 2;
      const hz = (bb.max.z - bb.min.z) / 2;
      const limX = Math.max(0, innerHalfW - hx);
      const limZ = Math.max(0, innerHalfD - hz);

      item.x = Math.max(-limX, Math.min(limX, item.x));
      item.z = Math.max(-limZ, Math.min(limZ, item.z));
      const lift = (item.shapeType === 'image' && !item.isStanding) ? 0.004 : 0;
      g.position.set(item.x - cx, bedTop - bb.min.y + lift, item.z - cz);

      boxGroup.rotation.y = savedRot;
    }

    let draggingItem = null;
    const raycaster = new THREE.Raycaster();
    const pointerNDC = new THREE.Vector2();
    const dragPlane = new THREE.Plane(new THREE.Vector3(0, 1, 0), -bedTop);
    const dragOffset = new THREE.Vector3();

    function setPointerFromEvent(e) {
      const r = renderer.domElement.getBoundingClientRect();
      pointerNDC.set(((e.clientX - r.left) / r.width) * 2 - 1, -((e.clientY - r.top) / r.height) * 2 + 1);
      raycaster.setFromCamera(pointerNDC, camera);
    }

    function pointOnBed() {
      const p = new THREE.Vector3();
      return raycaster.ray.intersectPlane(dragPlane, p) ? boxGroup.worldToLocal(p) : null;
    }

    function setupItemDragging() {
      const el = renderer.domElement;
      el.addEventListener('pointerdown', (e) => {
        if (e.button !== 0 || currentOpenProgress < 0.3 || !merchGroup || !merchGroup.visible) return;
        setPointerFromEvent(e);
        const hits = raycaster.intersectObjects(merchGroup.children.filter(c => c.userData.item), true);
        if (!hits.length) return;
        let o = hits[0].object;
        while (o && !o.userData.item) o = o.parent;
        if (!o) return;
        const item = o.userData.item;
        selectedItemIndex = customItemsList.indexOf(item);
        draggingItem = item;
        const p = pointOnBed();
        dragOffset.set(p ? item.x - p.x : 0, 0, p ? item.z - p.z : 0);
        controls.enabled = false;
        el.style.cursor = 'move';
        renderItemsStudioUI();
      });

      window.addEventListener('pointermove', (e) => {
        if (!draggingItem) return;
        setPointerFromEvent(e);
        const p = pointOnBed();
        if (!p) return;
        draggingItem.x = p.x + dragOffset.x;
        draggingItem.z = p.z + dragOffset.z;
        refitItem(draggingItem);
        syncSlidersWithSelectedItem();
      });

      window.addEventListener('pointerup', () => {
        if (!draggingItem) return;
        draggingItem = null;
        controls.enabled = true;
        renderer.domElement.style.cursor = '';
      });
    }

    function createCustomItemFromData(config) {
      const itemGroup = new THREE.Group();
      const shapeType = config.shapeType || 'cutout';
      const baseColor = config.baseColor || '#111215';
      const depth = config.depth || 0.08;
      const aspect = config.aspect || 1.0;

      const meshGroup = createVolumetricItemMesh(shapeType, config.texture, baseColor, depth, aspect, config.model);
      itemGroup.add(meshGroup);
      merchGroup.add(itemGroup);

      const itemData = {
        name: config.name || `Objeto #${customItemsList.length + 1}`,
        group: itemGroup,
        meshGroup: meshGroup,
        shapeType: shapeType,
        baseColor: baseColor,
        texture: config.texture,
        model: config.model || null,
        textureRotation: 0,
        artName: config.artName || "Prediseño",
        x: config.x || 0,
        z: config.z || 0,
        rotY: config.rotY || 0,
        scale: config.scale || 1.0,
        depth: depth,
        isStanding: !!config.isStanding,
        aspect: aspect
      };

      itemGroup.userData.item = itemData;
      customItemsList.push(itemData);
      selectedItemIndex = customItemsList.length - 1;
      refitItem(itemData);
      return itemData;
    }

    function rotateSelectedItemTexture() {
      const item = customItemsList[selectedItemIndex];
      if (!item || !item.texture) return;
      item.textureRotation = ((item.textureRotation || 0) + Math.PI / 2) % (Math.PI * 2);
      item.texture.center.set(0.5, 0.5);
      item.texture.rotation = item.textureRotation;
      item.texture.needsUpdate = true;
    }

    function rebuildSelectedItemMesh() {
      const item = customItemsList[selectedItemIndex];
      if (!item) return;
      item.group.remove(item.meshGroup);
      item.meshGroup = createVolumetricItemMesh(item.shapeType, item.texture, item.baseColor, item.depth, item.aspect, item.model);
      item.group.add(item.meshGroup);
      refitItem(item);
    }

    function changeSelectedItemShape(shapeType) {
      const item = customItemsList[selectedItemIndex];
      if (!item) return;
      item.shapeType = shapeType;
      if (!item.texture && shapeType !== 'model') item.texture = createDefaultItemTexture(item.name);
      rebuildSelectedItemMesh();
      syncSlidersWithSelectedItem();
    }

    function changeSelectedItemColor(hexVal) {
      const item = customItemsList[selectedItemIndex];
      if (!item) return;
      item.baseColor = hexVal;
      rebuildSelectedItemMesh();
      const lbl = document.getElementById('label-item-color');
      if (lbl) lbl.innerText = hexVal;
    }

